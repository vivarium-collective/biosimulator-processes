# --- Gateway (Go with air) ---
local_resource(
    "gateway",
    cmd="make gateway",
    deps=["gateway", "proto"],
    env={"RUN_MODE": "local"},
    allow_parallel=True
)

# --- Server (Go with air) ---
local_resource(
    "server",
    cmd="make server",
    deps=["server", "proto"],
    env={"RUN_MODE": "local"},
    allow_parallel=True
)

# --- Runner (Python FastAPI with uvicorn) ---
local_resource(
    "runner",
    cmd="uv run python runner/main.py",
    deps=["runner"],
    env={"RUN_MODE": "local"},
    allow_parallel=True
)
