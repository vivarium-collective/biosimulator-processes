# TODO: fix this workflow to start services in the following order: gateway -> dispatcher -> runner -> worker (worker depends on both the dispatcher and runner connections)

# --- Gateway (Go with air) ---
local_resource(
    "gateway",
    cmd="cd gateway && air -c .air.toml",
    deps=["gateway", "proto"],
    allow_parallel=True
)

# --- Dispatcher (Go with air) ---
local_resource(
    "dispatcher",
    cmd="cd dispatcher && air -c .air.toml",
    deps=["dispatcher", "proto"],
    allow_parallel=True
)

# --- Runner (Python) ---
local_resource(
    "runner",
    cmd="uv run python runner/main.py",
    deps=["runner"],
    allow_parallel=True
)

# -- Worker (Go with air) ---
local_resource(
    "worker",
    cmd="cd worker && air -c .air.toml",
    deps=["worker", "proto", "runner"],
    allow_parallel=True
)




