# --- Gateway (Go with air) ---
local_resource(
    "gateway",
    cmd="make go module=gateway",
    deps=["gateway", "proto"],
    allow_parallel=True
)

# --- Server (Go with air) ---
local_resource(
    "server",
    cmd="make go module=server",
    deps=["server", "proto"],
    allow_parallel=True
)

# --- Runner (Python) ---
local_resource(
    "runner",
    cmd="uv run python runner/main.py",
    deps=["runner"],
    allow_parallel=True
)
